
DATABASE_URL=postgresql://user:mdp@localhost:5432/leaderboard_db

# Evaluator Agent system (optional)
OPENAI_API_KEY=sk-proj-XXX

NEXT_PUBLIC_APP_URL=https://mytwinleaderboard.osc-fr1.scalingo.io

# Connectors configuration (optionnal)
GOOGLE_CLIENT_ID=XXX
GOOGLE_CLIENT_SECRET=XXX
GOOGLE_REFRESH_TOKEN=XXX

GOOGLE_FOLDER_ID=XXX

GITHUB_TOKEN=XXX

# GitHub OAuth App — connect an org admin account via admin UI (Appearance tab)
# Register at: github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:3000/api/github-oauth/callback
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/github-oauth/callback
# AES-256 key for token encryption — generate: openssl rand -hex 32
GITHUB_TOKEN_ENCRYPTION_KEY=<64 hex chars>

GITHUB_WEBHOOK_SECRET=XXX

KAGGLE_USERNAME=XXX
KAGGLE_KEY=XXX

# API Configuration
API_PORT=3001
FRONTEND_URL=http://localhost:3000

# Environment
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-key-at-least-32-characters-long-please-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OpenTelemetry (Grafana Cloud)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-instance_id:api_token>
OTEL_SERVICE_NAME=leaderboard-api

# Validation challenges — local dev only, NEVER set in production. Lets the
# SSRF guard accept localhost/private endpoints, so a test model API running
# on the same machine as the app can be validated. See validation-challenges.md.
# VALIDATION_ALLOW_PRIVATE_ENDPOINTS=true